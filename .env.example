# =====================================================================
# Application Settings
# =====================================================================
API_NAME="Car Resale Consultancy API"
API_VERSION="1.0.0"

# =====================================================================
# Database Configuration (PostgreSQL + asyncpg)
# =====================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=car_resale_consultancy
DATABASE_USER=your_postgres_user
DATABASE_PASSWORD=your_postgres_password
DATABASE_DRIVERNAME=postgresql+asyncpg

# =====================================================================
# JWT & Security Configuration
# =====================================================================
JWT_SECRET_KEY=your_generated_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTE=20
JWT_REFRESH_EXPIRATION_DAYS=7

# =====================================================================
# Mailjet Email Service Credentials
# =====================================================================
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# =====================================================================
# API Request Retry Configurations (Email Service)
# =====================================================================
MAX_RETRIES=4
BASE_DELAY=1
MAX_DELAY=12

